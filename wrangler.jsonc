{
  // Despliegue en Cloudflare como sitio estático (Workers Static Assets).
  // El nombre debe coincidir con el nombre del proyecto creado en Cloudflare.
  "name": "gustech",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Las rutas inexistentes devuelven dist/404.html con estado 404.
    "not_found_handling": "404-page"
  }
}
