{
  // Despliegue en Cloudflare: sitio estático (Workers Static Assets) + un Worker chico que
  // atiende solo POST /api/contacto (formulario de contacto). El nombre debe coincidir con el
  // proyecto creado en Cloudflare.
  "name": "gustech",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Las rutas inexistentes devuelven dist/404.html con estado 404.
    "not_found_handling": "404-page",
    // El Worker solo se ejecuta para /api/*: el resto lo sirve Cloudflare directo.
    "run_worker_first": ["/api/*"]
  },
  // Contadores anti-spam (límite por persona y tope diario). Ver src/worker/guard.ts.
  "kv_namespaces": [{ "binding": "RATE", "id": "35bf6ffabb9d434090763264f6da376e" }],
  // Variables NO secretas. Los secretos (TURNSTILE_SECRET, RESEND_API_KEY) se cargan con
  // `wrangler secret put` o en el panel de Cloudflare; nunca van en el repo.
  "vars": {
    "MAIL_TO": "contacto@gustech.com.ar",
    "MAIL_FROM": "GUSTECH Web <web@envio.gustech.com.ar>",
    "SITE_ORIGIN": "https://gustech.com.ar"
  }
}
