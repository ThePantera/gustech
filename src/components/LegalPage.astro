---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legal, legalPages, formatLegalDate } from '../data/legal';

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  toc?: { id: string; label: string }[];
  current: string;
}

const { title, description, heading, lead, toc = [], current } = Astro.props;
const others = legalPages.filter((p) => p.href !== current);
const identity = [
  legal.razonSocial && ['Razón social', legal.razonSocial],
  legal.titularNombre && ['Titular', legal.titularNombre],
  legal.cuit && ['CUIT', legal.cuit],
  legal.domicilio && ['Domicilio', legal.domicilio],
].filter(Boolean) as [string, string][];
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container legal">
      <p class="eyebrow">Información legal</p>
      <h1>{heading}</h1>
      {lead && <p class="lead">{lead}</p>}
      <p class="legal-updated">
        Última actualización: <time datetime={legal.updated}>{formatLegalDate(legal.updated)}</time>
      </p>

      {
        identity.length > 0 && (
          <dl class="legal-id">
            {identity.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        toc.length > 0 && (
          <nav class="legal-toc" aria-label="Contenido de esta página">
            <p class="legal-toc-title">En esta página</p>
            <ol>
              {toc.map((t) => (
                <li>
                  <a href={`#${t.id}`}>{t.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="legal-body">
        <slot />
      </div>

      <nav class="legal-links" aria-label="Otros textos legales">
        <p class="legal-toc-title">Más información legal</p>
        <ul>
          {
            others.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 48rem;
  }
  .legal-updated {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .legal-id {
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: grid;
    gap: var(--space-2);
  }
  .legal-id div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .legal-id dt {
    font-weight: 600;
  }
  .legal-id dd {
    margin: 0;
  }
  .legal-toc,
  .legal-links {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .legal-toc-title {
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }
  .legal-toc ol,
  .legal-links ul {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-1);
  }
  .legal a {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }
  .legal-body {
    margin-top: var(--space-5);
  }
  .legal-body :global(h2) {
    font-size: var(--text-xl);
    margin: var(--space-5) 0 var(--space-3);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }
  .legal-body :global(p),
  .legal-body :global(li) {
    line-height: 1.7;
  }
  .legal-body :global(p) {
    margin: 0 0 var(--space-3);
  }
  .legal-body :global(ul) {
    margin: 0 0 var(--space-3);
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-2);
  }
  .legal-body :global(.legal-note) {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: var(--radius);
  }
  .legal-links {
    margin-top: var(--space-6);
  }
</style>
