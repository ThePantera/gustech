---
// Ilustraciones propias (SVG inline, decorativas) de cada paso de "Así es una atención".
// Dibujadas para GUSTECH con la paleta del sitio; no provienen de ninguna librería ni sitio externo.
interface Props {
  name: 'contar' | 'evaluar' | 'resolver' | 'cierre';
}
const { name } = Astro.props;
---

<svg class="art" viewBox="0 0 96 96" width="96" height="96" fill="none" aria-hidden="true" focusable="false">
  {
    name === 'contar' && (
      <>
        {/* Pantalla con una alerta */}
        <rect class="t s" x="8" y="30" width="54" height="38" rx="5" />
        <path class="s" d="M28 68v8M20 76h24" />
        <path class="a-fill s" d="M35 38 47 59H23Z" />
        <path class="s" d="M35 45v7" />
        <path class="s" d="M35 55.5h.01" />
        {/* Globo de chat */}
        <path class="f s" d="M58 10h26a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6H71l-9 8v-8h-4a6 6 0 0 1-6-6V16a6 6 0 0 1 6-6Z" />
        <path class="w" d="M64 23h.01M71 23h.01M78 23h.01" />
      </>
    )
  }
  {
    name === 'evaluar' && (
      <>
        {/* Carpeta con tildes */}
        <rect class="t s" x="12" y="14" width="46" height="66" rx="5" />
        <rect class="f s" x="25" y="8" width="20" height="12" rx="3" />
        <path class="a" d="m21 36 3.5 3.5L31 32" />
        <path class="s" d="M38 36h14" />
        <path class="a" d="m21 51 3.5 3.5L31 47" />
        <path class="s" d="M38 51h14" />
        <path class="s" d="M21 66h10" />
        {/* Lupa */}
        <circle class="white s" cx="62" cy="58" r="16" />
        <circle class="a" cx="62" cy="58" r="9" />
        <path class="s thick" d="m74 70 12 12" />
      </>
    )
  }
  {
    name === 'resolver' && (
      <>
        {/* Pantalla con tilde grande */}
        <rect class="t s" x="8" y="14" width="64" height="46" rx="5" />
        <path class="s" d="M32 60v10M22 70h28" />
        <circle class="f s" cx="40" cy="37" r="13" />
        <path class="w thick" d="m34 37 4.5 4.5L47 32" />
        {/* Llave */}
        <g transform="translate(55 46) scale(1.7)">
          <path
            class="white s tool"
            d="M14.5 6.5a4 4 0 0 0-5 5L3 18l3 3 6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2.5-.5-.5-2.5 2.5-2.5Z"
          />
        </g>
      </>
    )
  }
  {
    name === 'cierre' && (
      <>
        {/* Calendario con sello de OK */}
        <rect class="t s" x="10" y="18" width="62" height="58" rx="6" />
        <path class="s" d="M10 34h62M26 11v13M56 11v13" />
        <path class="s dots" d="M25 46h.01M41 46h.01M57 46h.01M25 60h.01M41 60h.01" />
        <circle class="f s" cx="70" cy="68" r="16" />
        <path class="w thick" d="m62 68 5.5 5.5L79 62" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Trazo base (azul marino) y detalles (cian). */
  .s {
    stroke: var(--color-navy);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .a {
    stroke: var(--color-primary);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .w {
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thick {
    stroke-width: 3.4;
  }
  .dots {
    stroke-width: 4;
  }
  .tool {
    stroke-width: 1.4;
  }
  /* Rellenos */
  .t {
    fill: rgb(6 182 212 / 0.14);
  }
  .f {
    fill: var(--color-primary);
  }
  .white {
    fill: #fff;
  }
  .a-fill {
    fill: #fde68a;
  }
</style>
