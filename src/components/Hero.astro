---
import { hero, cta } from '../data/site';

// Trayectos de los "paquetes de datos" que viajan por la red (mismas coordenadas que las líneas).
const packets = [
  { d: 'M200 160 L90 70', t: '3.6s', delay: '0s' },
  { d: 'M200 160 L320 60', t: '4.2s', delay: '1.1s' },
  { d: 'M200 160 L340 200', t: '3.9s', delay: '2.3s' },
  { d: 'M200 160 L110 250', t: '4.4s', delay: '0.6s' },
  { d: 'M200 160 L230 280', t: '3.4s', delay: '1.8s' },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Soporte y soluciones IT para empresas</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero-lead">{hero.description}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
        <a class="btn btn-on-dark" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>

    <!-- Composición abstracta de red e infraestructura. Decorativa, sin datos ni métricas. -->
    <svg
      class="hero-art"
      viewBox="0 0 400 320"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <g stroke="#2563EB" stroke-width="2" stroke-linecap="round" opacity="0.8">
        <path d="M200 160 90 70"></path>
        <path d="M200 160 320 60"></path>
        <path d="M200 160 340 200"></path>
        <path d="M200 160 110 250"></path>
        <path d="M200 160 230 280"></path>
        <path d="M90 70 40 150"></path>
        <path d="M320 60 370 120"></path>
        <path d="M340 200 300 270"></path>
        <path d="M110 250 50 240"></path>
      </g>
      <g class="ring ring-a" stroke="#06B6D4" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.6">
        <circle cx="200" cy="160" r="70"></circle>
      </g>
      <g class="ring ring-b" stroke="#06B6D4" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.6">
        <circle cx="200" cy="160" r="120"></circle>
      </g>
      <g fill="#101C32" stroke="#2563EB" stroke-width="2.5">
        <circle class="sat" style="--d: 0s" cx="90" cy="70" r="14"></circle>
        <circle class="sat" style="--d: 0.7s" cx="320" cy="60" r="14"></circle>
        <circle class="sat" style="--d: 1.4s" cx="340" cy="200" r="14"></circle>
        <circle class="sat" style="--d: 2.1s" cx="110" cy="250" r="14"></circle>
        <circle class="sat" style="--d: 2.8s" cx="230" cy="280" r="12"></circle>
      </g>
      <g fill="#06B6D4">
        <circle cx="40" cy="150" r="6"></circle>
        <circle cx="370" cy="120" r="6"></circle>
        <circle cx="300" cy="270" r="6"></circle>
        <circle cx="50" cy="240" r="6"></circle>
      </g>
      <circle class="ping" cx="200" cy="160" r="34" stroke="#06B6D4" stroke-width="2"></circle>
      <circle cx="200" cy="160" r="34" fill="#101C32" stroke="#06B6D4" stroke-width="3"></circle>
      <circle class="core" cx="200" cy="160" r="9" fill="#06B6D4"></circle>
      {
        packets.map((p) => (
          <circle
            class="packet"
            r="3.2"
            cx="0"
            cy="0"
            fill="#67E8F9"
            style={`offset-path: path('${p.d}'); --t: ${p.t}; --delay: ${p.delay}`}
          />
        ))
      }
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #cbd5e1;
    padding-block: var(--space-6);
    /* Brillos suaves de color sobre el azul marino. */
    background:
      radial-gradient(56rem 26rem at 88% 8%, rgb(37 99 235 / 0.3), transparent 62%),
      radial-gradient(44rem 24rem at 0% 100%, rgb(6 182 212 / 0.14), transparent 60%),
      var(--color-navy);
  }

  /* Cuadrícula técnica muy tenue que se desvanece hacia abajo. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(148 163 184 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 163 184 / 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero h1 {
    color: #fff;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-3);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .hero-lead {
    max-width: 38rem;
    font-size: var(--text-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .hero-art {
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  /* Los paquetes de datos solo se muestran si el navegador soporta offset-path. */
  .packet {
    opacity: 0;
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-7);
    }
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Movimiento: solo para quienes no pidieron reducirlo. Solo transform y opacity. */
  @media (prefers-reduced-motion: no-preference) {
    /* Entrada del texto: desliza hacia arriba (sin cambiar la opacidad, para no demorar la carga). */
    .hero-eyebrow,
    .hero h1,
    .hero-lead,
    .hero-actions {
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero h1 {
      animation-delay: 0.08s;
    }
    .hero-lead {
      animation-delay: 0.16s;
    }
    .hero-actions {
      animation-delay: 0.24s;
    }

    .hero-art {
      animation:
        art-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both,
        float 8s ease-in-out 1s infinite;
    }

    .ring {
      transform-box: fill-box;
      transform-origin: center;
    }
    .ring-a {
      animation: spin 70s linear infinite;
    }
    .ring-b {
      animation: spin 110s linear infinite reverse;
    }

    .sat {
      transform-box: fill-box;
      transform-origin: center;
      animation: beat 3.4s ease-in-out var(--d, 0s) infinite;
    }

    .ping {
      fill: none;
      transform-box: fill-box;
      transform-origin: center;
      animation: ping 3s ease-out infinite;
    }

    .core {
      transform-box: fill-box;
      transform-origin: center;
      animation: beat 2.4s ease-in-out infinite;
    }

    @supports (offset-path: path('M0 0')) {
      .packet {
        offset-rotate: 0deg;
        animation: travel var(--t, 4s) ease-in-out var(--delay, 0s) infinite;
      }
    }
  }

  @keyframes rise {
    from {
      transform: translateY(16px);
    }
    to {
      transform: none;
    }
  }
  @keyframes art-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes beat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.18);
    }
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @keyframes travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
</style>
