---
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';

// Texto propio de esta sección (no depende de site.ts).
const waText = 'Hola, quiero hacer una consulta sobre los servicios de GUSTECH.';
const whatsappHref = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(waText)}`;
---

<section class="section" id="contacto" aria-labelledby="contacto-title">
  <div class="container">
    <div class="contact-card">
      <div class="contact-info">
        <p class="eyebrow contact-eyebrow">Contacto</p>
        <h2 id="contacto-title">Contanos qué necesitás</h2>
        <p class="contact-lead">
          Sea para tu casa, tu estudio o toda una empresa: contanos qué te pasa y te respondemos con los próximos
          pasos. La primera consulta es gratuita y sin compromiso.
        </p>

        <div class="contact-buttons">
          <a class="btn btn-whatsapp" href={whatsappHref} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
            Escribinos por WhatsApp
          </a>
        </div>

        <p class="contact-alt">
          También podés escribirnos a <a href={`mailto:${site.email}`}>{site.email}</a> o llamar al{' '}
          <a href={site.phone.href}>{site.phone.display}</a>.
        </p>
        <p class="contact-alt">
          Atendemos de forma remota en toda Argentina y de forma presencial en CABA y AMBA.
        </p>
      </div>

      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact-card {
    display: grid;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5) var(--space-3);
    background: var(--color-navy);
    color: #cbd5e1;
    border-radius: var(--radius-lg);
  }

  .contact-card h2 {
    color: #fff;
  }

  .contact-eyebrow {
    color: var(--color-cyan);
  }

  .contact-lead {
    margin: 0 0 var(--space-4);
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Verde de WhatsApp oscurecido para cumplir contraste con texto blanco. */
  .btn-whatsapp {
    background: #128c4a;
    color: #fff;
  }
  .btn-whatsapp:hover {
    background: #0e7a3f;
  }

  .contact-alt {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
  }

  .contact-card a:not(.btn) {
    color: #fff;
    text-underline-offset: 3px;
  }
  .contact-card a:not(.btn):hover {
    color: var(--color-cyan);
  }
  /* El formulario es un panel claro: sus enlaces usan sus propios colores. */
  .contact-card :global(.cf a) {
    color: var(--color-primary-dark);
  }

  @media (min-width: 56rem) {
    .contact-card {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-5);
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
