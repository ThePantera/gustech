---
import { site, contact } from '../data/site';

// Sin backend: el botón abre el programa de correo del visitante con un mensaje precompletado.
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(contact.subject)}&body=${encodeURIComponent(contact.body)}`;
---

<section class="section" id="contacto" aria-labelledby="contacto-title">
  <div class="container">
    <div class="contact-card">
      <div>
        <p class="eyebrow contact-eyebrow">Contacto</p>
        <h2 id="contacto-title">Contanos qué necesita tu empresa</h2>
        <p class="contact-lead">
          Describí brevemente tu necesidad y coordinamos los próximos pasos. Escribinos a{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <div class="contact-action">
        <div class="contact-buttons">
          <a class="btn btn-primary" href={mailto}>Solicitar asesoramiento por correo</a>
          <button type="button" class="btn btn-on-dark copy-email" data-email={site.email}>
            Copiar correo
          </button>
        </div>
        <p class="visually-hidden" role="status" aria-live="polite" id="copy-status"></p>
        <p class="contact-note">
          El primer botón abre tu programa de correo con un mensaje precompletado. Si no usás uno, copiá la
          dirección y escribinos desde tu correo web.
        </p>
        <p class="contact-phone">
          También podés llamar al <a href={site.phone.href}>{site.phone.display}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copia la dirección de correo al portapapeles (para quien no usa un programa de correo).
  const button = document.querySelector<HTMLButtonElement>('.copy-email');
  const status = document.querySelector<HTMLElement>('#copy-status');

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Respaldo para navegadores o contextos sin la API del portapapeles.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  }

  if (button) {
    const original = button.textContent?.trim() ?? 'Copiar correo';
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      const ok = await copyText(button.dataset.email ?? '');
      button.textContent = ok ? 'Correo copiado' : 'No se pudo copiar';
      if (status) {
        status.textContent = ok
          ? 'Correo copiado al portapapeles.'
          : 'No se pudo copiar. Seleccioná la dirección y copiala manualmente.';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = original;
      }, 2500);
    });
  }
</script>

<style>
  /* Sin JavaScript el botón de copiar no funcionaría: queda oculto. */
  .copy-email {
    display: none;
  }
  :global(html.js) .copy-email {
    display: inline-flex;
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact-card {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5) var(--space-4);
    background: var(--color-navy);
    color: #cbd5e1;
    border-radius: var(--radius-lg);
  }

  .contact-card h2 {
    color: #fff;
  }

  .contact-eyebrow {
    color: var(--color-cyan);
  }

  .contact-lead {
    margin: 0;
  }

  .contact-card a:not(.btn) {
    color: #fff;
    text-underline-offset: 3px;
  }
  .contact-card a:not(.btn):hover {
    color: var(--color-cyan);
  }

  .contact-note {
    margin: var(--space-2) 0 0;
    font-size: 0.875rem;
    color: #94a3b8;
  }

  .contact-phone {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }
  /* Área táctil de al menos 44 px de alto. */
  .contact-phone a {
    display: inline-block;
    padding-block: 0.65rem;
  }

  @media (min-width: 56rem) {
    .contact-card {
      grid-template-columns: 1.3fr 1fr;
      padding: var(--space-6) var(--space-5);
    }
    .contact-action {
      justify-self: end;
      max-width: 20rem;
    }
  }
</style>
