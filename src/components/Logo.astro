---
// Logo: PROTOTIPO aportado por el propietario (public/logo-g.webp) + nombre en texto.
// Reemplazar la imagen cuando exista el logo definitivo.
// El contorno del isotipo es azul marino: sobre fondos oscuros se muestra sobre una base clara.
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo-light': light }]}>
  <span class="logo-mark">
    <img src="/logo-g.webp" width="43" height="44" alt="" decoding="async" />
  </span>
  <span class="logo-text">
    <span class="logo-name">GUSTECH</span>{' '}
    <span class="logo-sub">IT Solutions</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-navy);
  }
  .logo-mark {
    display: inline-flex;
    flex: none;
  }
  .logo-mark img {
    display: block;
    height: 44px;
    width: auto;
  }
  .logo-light .logo-mark {
    padding: 4px;
    background: #e9eef2;
    border-radius: 10px;
  }
  .logo-light .logo-mark img {
    height: 40px;
  }
  .logo-light {
    color: #fff;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo-name {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }
  .logo-sub {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .logo-light .logo-sub {
    color: #cbd5e1;
  }
</style>
