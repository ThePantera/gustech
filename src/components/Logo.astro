---
// Logotipo tipográfico PROVISORIO: símbolo geométrico + texto.
// No es una marca oficial. Reemplazar este componente cuando exista el logo definitivo.
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo-light': light }]}>
  <svg class="logo-mark" viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="#101C32"></rect>
    <path
      d="M32 14 48 23.5v17L32 50 16 40.5v-17L32 14Z"
      fill="none"
      stroke="#2563EB"
      stroke-width="5"
      stroke-linejoin="round"></path>
    <circle cx="32" cy="32" r="5" fill="#06B6D4"></circle>
  </svg>
  <span class="logo-text">
    <span class="logo-name">GUSTECH</span>{' '}
    <span class="logo-sub">IT Solutions</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-navy);
  }
  .logo-light {
    color: #fff;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo-name {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }
  .logo-sub {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .logo-light .logo-sub {
    color: #cbd5e1;
  }
</style>
