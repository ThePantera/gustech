---
import { solutions } from '../data/site';
---

<section class="section" id="soluciones" aria-labelledby="soluciones-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Para quién trabajamos</p>
      <h2 id="soluciones-title">Una propuesta que se adapta a cada cliente</h2>
    </div>

    <div class="card-grid solutions-grid">
      {
        solutions.map((solution) => (
          <article class="card solution-card">
            <h3>{solution.title}</h3>
            <p>{solution.text}</p>
          </article>
        ))
      }
    </div>

    <p class="note">
      Trabajamos por abono mensual o con servicios puntuales, siempre sujetos a relevamiento y propuesta.
    </p>
  </div>
</section>

<style>
  /* Cuatro tarjetas: 2 × 2 en pantallas anchas, en lugar de 3 + 1. */
  @media (min-width: 48rem) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .solution-card {
    border-top: 3px solid var(--color-primary);
  }
  .solution-card p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
