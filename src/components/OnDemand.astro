---
import OnDemandArt from './OnDemandArt.astro';
import { onDemand } from '../data/site';

// Ilustración de cada modalidad, según el ícono que ya tenía en site.ts.
const art = { headset: 'remoto', wrench: 'visita', bolt: 'urgencia' } as const;
---

<section class="section section-alt" id="a-demanda" aria-labelledby="demanda-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Atención a demanda</p>
      <h2 id="demanda-title">Soporte cuando lo necesitás, sin abonos obligatorios</h2>
      <p class="lead">{onDemand.lead}</p>
    </div>

    <div class="card-grid">
      {
        onDemand.levels.map((level) => (
          <article class="card level-card">
            <div class="level-icon">
              <OnDemandArt name={art[level.icon as 'headset' | 'wrench' | 'bolt']} />
            </div>
            <h3>{level.title}</h3>
            <p class="level-text">{level.text}</p>
            <ul>
              {level.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .level-icon {
    display: inline-grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    margin-bottom: var(--space-3);
    padding: 0.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .level-text {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  li::marker {
    color: var(--color-cyan);
  }
</style>
