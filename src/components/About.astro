---
import { about } from '../data/site';
---

<section class="section section-alt" id="nosotros" aria-labelledby="nosotros-title">
  <div class="container about">
    <p class="eyebrow">Nosotros</p>
    <h2 id="nosotros-title">Soluciones tecnológicas prácticas para empresas y profesionales</h2>
    <p class="lead">{about.text}</p>
  </div>
</section>

<style>
  .about {
    max-width: 48rem;
  }
  .about .lead {
    margin: 0;
  }
</style>
